@model ECommerceApp.Application.Sales.Coupons.DTOs.CreateCouponDto
@{
    ViewData["Title"] = "Dodaj kupon";
}

<div class="container mt-4" style="max-width:760px;">
    <h2><i class="fa-solid fa-ticket me-2"></i>Dodaj kupon</h2>

    <form id="couponCreateForm" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="All" class="alert alert-danger" id="validationSummary"></div>

        <div class="mb-3">
            <label asp-for="Code" class="form-label">Kod</label>
            <input asp-for="Code" class="form-control" placeholder="np. SUMMER20" required />
            <span asp-validation-for="Code" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label">Opis</label>
            <input asp-for="Description" class="form-control" required />
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <partial name="_RuleBuilder" model="Model.Rules" />

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Dodaj</button>
            <a asp-action="Index" class="btn btn-secondary">Anuluj</a>
        </div>
    </form>
</div>

@section PreScripts {
    <partial name="_ValidationScriptsPartial" />
}

@section Scripts {
    <script src="~/js/coupon-rule-builder.js" asp-append-version="true"></script>
    <script>
        require(["coupon-rule-builder"], function (builder) {
            var root = document.getElementById("couponRuleBuilder");
            builder.initialize(root);
            root.dataset.ready = "true";
        });
    </script>
}

