{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "node -e \"const fs=require('fs'),p=require('path');let d=process.cwd();while(!fs.existsSync(p.join(d,'.github/hooks/go-gate-adapter.mjs'))&&p.dirname(d)!==d)d=p.dirname(d);import(require('url').pathToFileURL(p.join(d,'.github/hooks/go-gate-adapter.mjs')).href).then(m=>m.run(),()=>process.exit(0))\"",
