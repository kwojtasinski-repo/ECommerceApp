{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const d=process.env.CLAUDE_PROJECT_DIR||process.cwd();import(require('url').pathToFileURL(d+'/.claude/hooks/go-gate-adapter.mjs').href).then(m=>m.run(),()=>process.exit(0))\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const d=process.env.CLAUDE_PROJECT_DIR||process.cwd();import(require('url').pathToFileURL(d+'/.claude/hooks/go-gate-adapter.mjs').href).then(m=>m.run(),()=>process.exit(0))\""
          }
        ]
      }
    ]
  }
}
